{
    "mcpServers": {
        "gaia-http": {
            "url": "http://localhost:5059/mcp",
            "type": "http"
        },
        "gaia-stdio": {
            "transport": "stdio",
            "type": "stdio",
            "command": "dotnet",
            "env": {
                "MCP_TRANSPORT": "stdio"
            },
            "args": [
                "run",
                "--project",
                "src/Gaia.Mcp.Server/Gaia.Mcp.Server.csproj"
            ]
        }
    }
}
